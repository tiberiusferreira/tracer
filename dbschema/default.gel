module default {

    type EntityChange{
        required entity_name: str;
        required entity_id: uuid;
        required execution_external_id: uuid;
        old: json;
        required new: json;
        required created_at: datetime {
            default := datetime_of_statement();
            readonly := true;
        };
    }

    type Execution {
        required service_instance: ServiceInstance;
        required external_id: uuid{
            constraint exclusive;
        };
        required started_at: datetime;
        required last_seen_at: datetime;
        required duration_ms := <int64>(duration_to_seconds(duration_truncate(.last_seen_at-.started_at, "milliseconds"))*1000);
        required ended: bool {
            default := false
        };
        required replay_data: json;
        required size_bytes := len(to_str(.replay_data));
        required created_at: datetime {
            default := datetime_of_statement();
            readonly := true;
        };
        index on ((.started_at, .last_seen_at));
    }

    type AttributeName {
        required _value: str {
            constraint exclusive;
        };
    }

    type AttributeValue {
        required _value: str {
            constraint exclusive;
        };
    }

    type ExecutionAttribute {
        required execution: Execution;
        required normalized_name: AttributeName;
        required name := .normalized_name._value;
        normalized_value: AttributeValue;
        _value := .normalized_value._value;
        required created_at: datetime {
            default := datetime_of_statement();
            readonly := true;
        };
    }


    type UiLayout {
        annotation description := 'Saves ui layout configurations';
        required name: str {
            constraint max_len_value(256);
            readonly := true;
        };
        required window_second: int64 {
            constraint min_value(1);
        };
        required roll_up_window_second: int64 {
            constraint min_value(1);
        };
        required filters: json {
            readonly := true;
            constraint max_len_value(4096)
        };
        required created_at: datetime {
            readonly := true;
            default := datetime_of_statement();
        };
        constraint exclusive on ((.name));
    }


    type Service {
      required env: str {
        constraint max_len_value(256);
        readonly := true;
      };
      required name: str {
        constraint max_len_value(256);
        readonly := true;
       };
      multi instances := .<service[is ServiceInstance];
      constraint exclusive on ((.env, .name));
    }


    type ServiceInstance {
      required service: Service;
      latest_profile_base64: str;
      required registered_at: datetime {
        default := datetime_of_statement();
        readonly := true;
      };
    }


};

