module default {

    type EntityChange{
        required entity_name: str;
        required entity_id: uuid;
        required execution: uuid;
        old: json;
        required new: json;
        required created_at: datetime {
            default := datetime_of_statement();
            readonly := true;
        };
    }

    type Execution {
        required service_instance: ServiceInstance;
        required external_id: uuid{
            constraint exclusive;
        };
        required started_at: datetime;
        required last_seen_at: datetime;
        required ended: bool {
            default := false
        };
        required replay_data: json;
        required executed_functions: json;
        required size_bytes := len(to_str(.replay_data)) + len(to_str(.executed_functions));
        required created_at: datetime {
            default := datetime_of_statement();
            readonly := true;
        };

    }

    type Attributes {
        required execution: Execution;
        required name: str;
        required _value: str;

    }

#    type TransactionRecording {
#        required external_id: int64;
#        required started_at: datetime;
#        multi queries: QueryWithResult;
#        ended_at: datetime;
#        result: json;
#    }
#
#    type QueryWithResult {
#        required external_id: int64;
#        required started_at: datetime;
#        required query_with_parameters: json;
#        result: json;
#        ended_at: datetime;
#        required created_at: datetime {
#           default := datetime_of_statement();
#           readonly := true;
#        };
#    }



    type UiLayout {
        annotation description := 'Saves ui layout configurations';
        required name: str {
            constraint max_len_value(256);
            readonly := true;
        };
        required window_second: int64 {
            constraint min_value(1);
        };
        required roll_up_window_second: int64 {
            constraint min_value(1);
        };
        required filters: json {
            readonly := true;
            constraint max_len_value(4096)
        };
        required created_at: datetime {
            readonly := true;
            default := datetime_of_statement();
        };
        constraint exclusive on ((.name));
    }


    type Service {
      required env: str {
        constraint max_len_value(256);
        readonly := true;
      };
      required name: str {
        constraint max_len_value(256);
        readonly := true;
       };
      multi instances := .<service[is ServiceInstance];
      constraint exclusive on ((.env, .name));
    }


    type ServiceInstance {
      required service: Service;
      required received_update_count: int64 {
        default := 0;
        constraint min_value(0);
      };
      required registered_at: datetime {
        default := datetime_of_statement();
        readonly := true;
      };
    }

    type ServiceInstanceUpdate {
      required service_instance: ServiceInstance;
      required export_buffer_size_bytes: int64;
      required produced_at: datetime{
        annotation description := "When this was produced."
      };
      required created_at: datetime {
        default := datetime_of_statement();
        readonly := true;
      };
    }


    # Attributes are repeated over and over
    type NormalizedAttributeName{
       required _value: str {
        constraint max_len_value(1024);
        constraint exclusive;
      };
    }



};

